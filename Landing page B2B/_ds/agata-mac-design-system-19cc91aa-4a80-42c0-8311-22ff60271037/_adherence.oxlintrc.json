{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/cards/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/client-portal/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Sora|Inter))/i]",
        "message": "Font not provided by the design system. Available: Sora, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|children|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: type, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:info|success|warning|danger|ai)$/]",
        "message": "<Alert> type must be one of 'info' | 'success' | 'warning' | 'danger' | 'ai'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|icon|children|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, icon, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|action|secondary|secondary-inverse|tertiary|whatsapp)$/]",
        "message": "<Button> variant must be one of 'primary' | 'action' | 'secondary' | 'secondary-inverse' | 'tertiary' | 'whatsapp'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:operadora|plano|acomodacao|abrangencia|copart|preco|recommended|key|ref|className|style|children)$/]",
        "message": "<ComparisonCard> doesn't accept that prop. Declared props: operadora, plano, acomodacao, abrangencia, copart, preco, recommended."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonTableRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:cells|recommended|key|ref|className|style|children)$/]",
        "message": "<ComparisonTableRow> doesn't accept that prop. Declared props: cells, recommended."
      },
      {
        "selector": "JSXOpeningElement[name.name='FAQItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:q|a|key|ref|className|style|children)$/]",
        "message": "<FAQItem> doesn't accept that prop. Declared props: q, a."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndicatorCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|detail|key|ref|className|style|children)$/]",
        "message": "<IndicatorCard> doesn't accept that prop. Declared props: value, label, detail."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|helper|state|value|onChange|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, placeholder, helper, state, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|success|error|disabled)$/]",
        "message": "<Input> state must be one of 'default' | 'success' | 'error' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Navbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|logoSrc|key|ref|className|style|children)$/]",
        "message": "<Navbar> doesn't accept that prop. Declared props: active, logoSrc."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|bullets|ctaLabel|highlighted|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: icon, title, description, bullets, ctaLabel, highlighted."
      },
      {
        "selector": "JSXOpeningElement[name.name='Timeline'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|key|ref|className|style|children)$/]",
        "message": "<Timeline> doesn't accept that prop. Declared props: steps, current."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
